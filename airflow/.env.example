# Configuration de la connexion Airflow snowflake_nyc_taxi (JSON).
# Fichier local : airflow/.env, chargé par astro dev start et exclu de Git.
# Renseigner l’identifiant de compte Snowflake (ORGANISATION-COMPTE).
# private_key_content : clé PKCS8 sur une ligne, avec les retours encodés en \n.
AIRFLOW_CONN_SNOWFLAKE_NYC_TAXI='{"conn_type":"snowflake","login":"AIRFLOW_SVC","extra":{"account":"ORGANISATION-COMPTE","warehouse":"NYC_TAXI_WH","database":"NYC_TAXI","role":"TRANSFORMER","private_key_content":"<CLE_PRIVEE_PKCS8_AVEC_RETOURS_ECHAPPES>\n"}}'
